{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "currency-swagger-route": {
        "ClusterId": "currency-api",
        "Match": {
          "Path": "/currency/swagger/{**remainder}"
        }
      },
      "user-swagger-route": {
        "ClusterId": "user-api",
        "Match": {
          "Path": "/user/swagger/{**remainder}"
        }
      },

      "currency-route": {
        "ClusterId": "currency-api",
        "Match": {
          "Path": "/api/Currency/{**remainder}"
        }
      },
      "user-route": {
        "ClusterId": "user-api",
        "Match": {
          "Path": "/api/User/{**remainder}"
        }
      },
      "user-auth-route": {
        "ClusterId": "user-auth-api",
        "Match": {
          "Path": "/api/Auth/{**remainder}"
        }
      }
    },
    "Clusters": {
      "currency-api": {
        "Destinations": {
          "currency-api/destination1": {
            "Address": "http://localhost:5120/"
          }
        }
      },
      "user-api": {
        "Destinations": {
          "user-api/destination1": {
            "Address": "http://localhost:5110/"
          }
        }
      },
      "user-auth-api": {
        "Destinations": {
          "user-api/destination1": {
            "Address": "http://localhost:5110/"
          }
        }
      }
    }
  }
}